# Copy this file to .env and fill in ONE of the two configuration styles
# below. Never commit the real .env file anywhere.

# --- Style 1: a single connection string --------------------------------
# Paste this straight from the Aiven console's "Service URI" field for
# either service type. The script rewrites postgres:// / mysql:// to the
# right SQLAlchemy driver automatically.
# DATABASE_URL=postgres://avnadmin:PASSWORD@your-service-host.aivencloud.com:12345/defaultdb?sslmode=require
# DATABASE_URL=mysql://avnadmin:PASSWORD@your-service-host.aivencloud.com:12345/defaultdb

# --- Style 2: discrete fields, if that's what you copied from Aiven -----
# DB_ENGINE=postgres        # or: mysql
# DB_HOST=your-service-host.aivencloud.com
# DB_PORT=12345
# DB_USER=avnadmin
# DB_PASSWORD=PASSWORD
# DB_NAME=defaultdb

# --- TLS (Aiven requires TLS for both engines) ---------------------------
# DB_SSLMODE=require                 # Postgres: require | verify-ca | verify-full
# DB_SSL_CA_PATH=/path/to/ca.pem     # optional: the CA cert Aiven lets you download,
                                     # for strict certificate verification on either engine

# --- Size guard ------------------------------------------------------------
# Refuse to load (or warn) past this many bytes. Defaults to 400 MB.
# MAX_DB_BYTES=400000000

# --- Scope (optional overrides; see config.py for the curated defaults) ---
# WDI_YEAR_START=1990
# WDI_YEAR_END=2024
# WPP_YEAR_START=1990
# WPP_YEAR_END=2024
# WPP_INCLUDE_PROJECTIONS=0
